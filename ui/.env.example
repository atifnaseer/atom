# Copy this file to .env and fill in the values for your environment.
# cp .env.example .env

# GraphQL endpoint exposed by the Atom backend (server-side only).
# 8080 = the `make up` backend. Use 8090 for the host `make dev` backend.
ATOM_GRAPHQL_URL=http://localhost:8080/graphql

# Credentials for the bootstrap admin entity created by migrations.
ATOM_ADMIN_IDENTIFIER=admin
ATOM_ADMIN_SECRET=12345678

# Minimum password length — must match the backend ATOM_MIN_PASSWORD_CHARS value.
ATOM_MIN_PASSWORD_CHARS=8

# Must match the backend value — skips the "check your email" step after signup.
ATOM_ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Atom service token of the Ejad UI (MG_ATOM_TOKEN_EJAD_UI in Magistrala's
# docker/.env.tokens). Server-side only, used by the connect/disconnect route
# after its role check. Never expose it to the browser (no NEXT_PUBLIC_).
EJAD_ATOM_SERVICE_TOKEN=

# Magistrala messaging services (server-side only).
# Message reader: GET /{workspace}/channels/{channel}/messages
MG_READER_URL=http://localhost:9011
# HTTP adapter: POST /m/{workspace}/c/{channel}
MG_HTTP_URL=http://localhost/http
# MQTT broker shown in generated device commands.
MG_MQTT_HOST=localhost
MG_MQTT_PORT=1883
